<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orbit_App.Controls.WorkbenchDetailPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="360"
    MaxWidth="1200"
    MinHeight="400"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <!-- Outer padding so FlyoutPresenter doesn't clip the accent stroke -->
    <Grid Padding="6">
        <Border
            Padding="0"
            Background="{ThemeResource OrbitDetailSurfaceBrush}"
            BorderBrush="{ThemeResource OrbitCellAccentBrush}"
            BorderThickness="1.5"
            CornerRadius="16">
            <!-- Inset content so TabView/children never paint over the stroke -->
            <Grid Margin="1.5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Padding="16,14"
                    Background="{ThemeResource OrbitDetailHeaderBrush}"
                    CornerRadius="14.5,14.5,0,0">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="BackButton"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Back"
                        Click="Back_Click"
                        CornerRadius="20"
                        Padding="8,6"
                        Style="{StaticResource SubtleButtonStyle}"
                        ToolTipService.ToolTip="Back"
                        Visibility="Collapsed">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    </Button>
                    <Image
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Source="ms-appx:///Assets/Brand/orbit-64.png"
                        Stretch="Uniform"
                        VerticalAlignment="Top" />
                    <StackPanel Grid.Column="2" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE8B7;" Opacity="0.7" />
                            <TextBlock
                                x:Name="ProjectLabel"
                                Opacity="0.7"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Project" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="TitleBox"
                                FontSize="20"
                                FontWeight="SemiBold"
                                AcceptsReturn="False"
                                TextWrapping="NoWrap"
                                LostFocus="TitleBox_LostFocus"
                                KeyDown="TitleBox_KeyDown"
                                PlaceholderText="Title"
                                Background="Transparent"
                                BorderThickness="0,0,0,1" />
                            <Button
                                x:Name="DeleteTaskButton"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Delete task"
                                Click="DeleteTask_Click"
                                CornerRadius="20"
                                Padding="8,6"
                                Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Delete this task"
                                Visibility="Collapsed">
                                <FontIcon FontSize="16" Glyph="&#xE74D;" Foreground="#E81123" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <Button
                        Grid.Column="3"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Close detail"
                        Click="Close_Click"
                        Content="✕"
                        CornerRadius="20"
                        Padding="10,6"
                        Style="{StaticResource SubtleButtonStyle}" />
                </Grid>
            </Border>

            <TabView
                x:Name="DetailTabs"
                Grid.Row="1"
                IsAddTabButtonVisible="False"
                CanReorderTabs="False"
                TabWidthMode="SizeToContent"
                Margin="8,4,8,0">
                <TabViewItem IsClosable="False" IsSelected="True">
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE8A5;" />
                            <TextBlock FontWeight="SemiBold" Text="Brief" />
                        </StackPanel>
                    </TabViewItem.Header>
                    <ScrollViewer Padding="14,10" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="OverviewHost" Spacing="12" />
                    </ScrollViewer>
                </TabViewItem>
                <TabViewItem IsClosable="False">
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE99A;" />
                            <TextBlock Text="Agent" />
                        </StackPanel>
                    </TabViewItem.Header>
                    <Grid Padding="14,10" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4" Margin="0,0,0,4">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Hermes" />
                            <TextBlock
                                Opacity="0.65"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Secondary — brief lives on Brief. Use Agent for mutations when needed."
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <Border
                            Grid.Row="1"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    x:Name="AgentTranscript"
                                    TextWrapping="WrapWholeWords"
                                    IsTextSelectionEnabled="True"
                                    LineHeight="22" />
                            </ScrollViewer>
                        </Border>
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="AgentInput"
                                AcceptsReturn="False"
                                CornerRadius="12"
                                KeyDown="AgentInput_KeyDown"
                                PlaceholderText="Ask Hermes…" />
                            <Button
                                Grid.Column="1"
                                Click="AgentSend_Click"
                                Content="Send"
                                CornerRadius="12"
                                Padding="16,8"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Grid>
                </TabViewItem>
                <TabViewItem IsClosable="False">
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE70B;" />
                            <TextBlock Text="Notes" />
                        </StackPanel>
                    </TabViewItem.Header>
                    <ScrollViewer Padding="14,10" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NotesHost" Spacing="10" />
                    </ScrollViewer>
                </TabViewItem>
                <TabViewItem IsClosable="False">
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE71B;" />
                            <TextBlock Text="Links" />
                            <InfoBadge
                                x:Name="LinksBadge"
                                Visibility="Collapsed"
                                Style="{ThemeResource AttentionValueInfoBadgeStyle}" />
                        </StackPanel>
                    </TabViewItem.Header>
                    <ScrollViewer Padding="14,10" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LinksHost" Spacing="10" />
                    </ScrollViewer>
                </TabViewItem>
                <TabViewItem IsClosable="False">
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE716;" />
                            <TextBlock Text="Contacts" />
                        </StackPanel>
                    </TabViewItem.Header>
                    <ScrollViewer Padding="14,10" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ContactsHost" Spacing="10" />
                    </ScrollViewer>
                </TabViewItem>
                <TabViewItem IsClosable="False">
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE8B7;" />
                            <TextBlock Text="Files" />
                        </StackPanel>
                    </TabViewItem.Header>
                    <ScrollViewer Padding="14,10" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FilesHost" Spacing="10" />
                    </ScrollViewer>
                </TabViewItem>
                <TabViewItem IsClosable="False">
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE713;" />
                            <TextBlock Text="Fields" />
                        </StackPanel>
                    </TabViewItem.Header>
                    <ScrollViewer Padding="14,10" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FieldsHost" Spacing="10" />
                    </ScrollViewer>
                </TabViewItem>
            </TabView>

            <Border
                Grid.Row="2"
                Padding="14,10"
                Background="{ThemeResource OrbitDetailFooterBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,14.5,14.5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="ArchiveButton"
                        Click="Archive_Click"
                        CornerRadius="10"
                        Padding="14,8"
                        Style="{StaticResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock Text="Archive" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ArchiveProjectButton"
                        Click="ArchiveProject_Click"
                        CornerRadius="10"
                        Padding="14,8"
                        Style="{StaticResource SubtleButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                            <TextBlock Text="Archive project" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="FooterHint"
                        VerticalAlignment="Center"
                        Opacity="0.65"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
