<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orbit_App.Controls.CompletedTasksPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="360"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid Padding="6">
        <Border
            Background="{ThemeResource OrbitDetailSurfaceBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1.5"
            CornerRadius="16">
            <Grid Margin="1.5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Padding="14,12"
                    Background="{ThemeResource OrbitDetailHeaderBrush}"
                    CornerRadius="14.5,14.5,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE73E;" Opacity="0.75" />
                                <TextBlock
                                    x:Name="ProjectLabel"
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Completed" />
                            </StackPanel>
                            <TextBlock
                                x:Name="TitleText"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="Completed tasks" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Click="Close_Click"
                            Content="✕"
                            CornerRadius="20"
                            Padding="10,6"
                            Style="{StaticResource SubtleButtonStyle}" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="14,10">
                    <StackPanel x:Name="ListHost" Spacing="8" />
                </ScrollViewer>

                <Border
                    Grid.Row="2"
                    Padding="14,10"
                    Background="{ThemeResource OrbitDetailFooterBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14.5,14.5">
                    <TextBlock
                        x:Name="FooterHint"
                        Opacity="0.65"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Open a task or reopen it into the active board." />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
