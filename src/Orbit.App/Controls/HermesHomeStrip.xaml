<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orbit_App.Controls.HermesHomeStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="12,10"
        Background="{ThemeResource OrbitDetailSurfaceBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource ControlCornerRadius}">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="CompactHeaderText"
                        FontWeight="SemiBold"
                        Text="Hermes"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        x:Name="ActivityText"
                        Opacity="0.7"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text=""
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Refresh Hermes pulse"
                    Click="RefreshButton_Click"
                    Content="Refresh"
                    ToolTipService.ToolTip="Ask Hermes for a duty scan and reload">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>

            <Expander
                x:Name="BriefExpander"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="False">
                <Expander.Header>
                    <TextBlock
                        x:Name="BriefHeaderText"
                        Opacity="0.85"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Show brief" />
                </Expander.Header>
                <StackPanel Spacing="4" Padding="0,4,0,0">
                    <TextBlock
                        x:Name="DayBriefText"
                        LineHeight="20"
                        Text="Loading…"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="HermesHintText"
                        Opacity="0.55"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </Expander>

            <Grid
                x:Name="LowConfidencePanel"
                Grid.Row="2"
                ColumnSpacing="8"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="LowConfidenceText"
                    VerticalAlignment="Center"
                    Opacity="0.75"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Low-confidence suggestions"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Name="OpenReviewButton"
                    Grid.Column="1"
                    Click="OpenReviewButton_Click"
                    Content="Review"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Open the sidebar review queue — decisions train Hermes" />
                <Button
                    x:Name="DismissLowButton"
                    Grid.Column="2"
                    Click="DismissLowButton_Click"
                    Content="Dismiss all"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Reject all pending suggestions below the review confidence band" />
            </Grid>

            <TextBlock
                x:Name="ConcernsHeader"
                Grid.Row="3"
                FontWeight="SemiBold"
                Opacity="0.85"
                Text="Needs you now"
                Visibility="Collapsed" />

            <ScrollViewer
                Grid.Row="4"
                MaxHeight="128"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <ItemsRepeater x:Name="ConcernsRepeater">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                MinWidth="180"
                                MaxWidth="280"
                                Padding="10,8"
                                Click="ConcernChip_Click"
                                HorizontalContentAlignment="Left"
                                Tag="{Binding TaskId}"
                                ToolTipService.ToolTip="{Binding ReasonLabel}">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding ContextLine}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Opacity="0.85"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding ActionLine}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Opacity="0.65"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding ReasonLabel}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
