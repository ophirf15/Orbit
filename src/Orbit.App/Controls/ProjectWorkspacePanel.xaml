<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Orbit_App.Controls.ProjectWorkspacePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="360"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">

    <Grid Padding="6">
        <Border
            Background="{ThemeResource OrbitDetailSurfaceBrush}"
            BorderBrush="{ThemeResource OrbitCellAccentBrush}"
            BorderThickness="1.5"
            CornerRadius="16">
            <Grid Margin="1.5" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Padding="14,12"
                    Background="{ThemeResource OrbitDetailHeaderBrush}"
                    CornerRadius="14.5,14.5,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE8B7;" Opacity="0.7" />
                                <TextBlock
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Project workspace" />
                            </StackPanel>
                            <TextBox
                                x:Name="TitleBox"
                                FontSize="20"
                                FontWeight="SemiBold"
                                AcceptsReturn="False"
                                TextWrapping="NoWrap"
                                LostFocus="TitleBox_LostFocus"
                                PlaceholderText="Project name"
                                Background="Transparent"
                                BorderThickness="0,0,0,1" />
                            <TextBox
                                x:Name="SummaryBox"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="48"
                                MaxHeight="96"
                                LostFocus="SummaryBox_LostFocus"
                                PlaceholderText="Project summary…"
                                Background="Transparent"
                                BorderThickness="0" />
                            <StackPanel Spacing="4" Margin="0,6,0,0">
                                <TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="Code" />
                                <TextBox
                                    x:Name="CodeBox"
                                    AcceptsReturn="False"
                                    LostFocus="CodeBox_LostFocus"
                                    PlaceholderText="Optional short code"
                                    Background="Transparent"
                                    BorderThickness="0,0,0,1" />
                                <TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="Aliases" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBox
                                        x:Name="AliasInputBox"
                                        MinWidth="140"
                                        AcceptsReturn="False"
                                        PlaceholderText="Add nickname…"
                                        KeyDown="AliasInputBox_KeyDown" />
                                    <Button Click="AddAlias_Click" Content="Add" Padding="10,4" />
                                </StackPanel>
                                <StackPanel x:Name="AliasesHost" Orientation="Horizontal" Spacing="6" />
                                <TextBlock Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="Dossier" Margin="0,8,0,0" />
                                <TextBlock
                                    x:Name="DossierEmptyHint"
                                    Opacity="0.55"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Empty dossier — fill call-ready fields below."
                                    Visibility="Collapsed" />
                                <TextBox x:Name="DossierAddressBox" LostFocus="DossierField_LostFocus" PlaceholderText="Address / property" Background="Transparent" BorderThickness="0,0,0,1" />
                                <TextBox x:Name="DossierOwnerBox" LostFocus="DossierField_LostFocus" PlaceholderText="Owner / client" Background="Transparent" BorderThickness="0,0,0,1" />
                                <TextBox x:Name="DossierPhaseBox" LostFocus="DossierField_LostFocus" PlaceholderText="Phase" Background="Transparent" BorderThickness="0,0,0,1" />
                                <TextBox x:Name="DossierPortfolioBox" LostFocus="DossierField_LostFocus" PlaceholderText="Portfolio" Background="Transparent" BorderThickness="0,0,0,1" />
                                <TextBox x:Name="DossierPrioritiesBox" LostFocus="DossierField_LostFocus" PlaceholderText="Current priorities (comma-separated)" Background="Transparent" BorderThickness="0,0,0,1" />
                            </StackPanel>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Close project workspace"
                            Click="Close_Click"
                            Content="✕"
                            CornerRadius="20"
                            Padding="10,6"
                            Style="{StaticResource SubtleButtonStyle}" />
                    </Grid>
                </Border>

                <ScrollViewer
                    Grid.Row="1"
                    Padding="12,8,12,8"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Opacity="0.85" Text="Due &amp; dependencies" />
                            <ScrollViewer
                                MaxHeight="72"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="DueStripHost" Orientation="Horizontal" Spacing="8" />
                            </ScrollViewer>
                            <StackPanel x:Name="DepsHost" Spacing="2" />
                        </StackPanel>

                        <Grid x:Name="MatrixGrid" ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="120" />
                                <RowDefinition Height="*" MinHeight="120" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                FontWeight="SemiBold"
                                Opacity="0.75"
                                Text="Urgent" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Center"
                                FontWeight="SemiBold"
                                Opacity="0.75"
                                Text="Less urgent" />

                            <TextBlock
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Opacity="0.75"
                                Text="Important"
                                TextWrapping="Wrap"
                                MaxWidth="72" />
                            <Border
                                x:Name="QuadDo"
                                Grid.Row="1"
                                Grid.Column="1"
                                MinHeight="140"
                                Padding="8"
                                AllowDrop="True"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                DragOver="Quadrant_DragOver"
                                Drop="Quadrant_Drop"
                                Tag="do">
                                <StackPanel x:Name="QuadDoHost" Spacing="6" />
                            </Border>
                            <Border
                                x:Name="QuadSchedule"
                                Grid.Row="1"
                                Grid.Column="2"
                                MinHeight="140"
                                Padding="8"
                                AllowDrop="True"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                DragOver="Quadrant_DragOver"
                                Drop="Quadrant_Drop"
                                Tag="schedule">
                                <StackPanel x:Name="QuadScheduleHost" Spacing="6" />
                            </Border>

                            <TextBlock
                                Grid.Row="2"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Opacity="0.75"
                                Text="Less important"
                                TextWrapping="Wrap"
                                MaxWidth="72" />
                            <Border
                                x:Name="QuadDelegate"
                                Grid.Row="2"
                                Grid.Column="1"
                                MinHeight="140"
                                Padding="8"
                                AllowDrop="True"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                DragOver="Quadrant_DragOver"
                                Drop="Quadrant_Drop"
                                Tag="delegate">
                                <StackPanel x:Name="QuadDelegateHost" Spacing="6" />
                            </Border>
                            <Border
                                x:Name="QuadDefer"
                                Grid.Row="2"
                                Grid.Column="2"
                                MinHeight="140"
                                Padding="8"
                                AllowDrop="True"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                DragOver="Quadrant_DragOver"
                                Drop="Quadrant_Drop"
                                Tag="defer">
                                <StackPanel x:Name="QuadDeferHost" Spacing="6" />
                            </Border>
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Opacity="0.85" Text="Notes" />
                            <StackPanel x:Name="NotesHost" Spacing="6" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Opacity="0.85" Text="Fields" />
                            <StackPanel x:Name="FieldsHost" Spacing="6" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border
                    Grid.Row="2"
                    Padding="14,10"
                    Background="{ThemeResource OrbitDetailFooterBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14.5,14.5">
                    <Grid>
                        <Button
                            x:Name="ArchiveButton"
                            Click="Archive_Click"
                            CornerRadius="10"
                            Padding="14,8"
                            Style="{StaticResource SubtleButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                                <TextBlock Text="Archive project" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            x:Name="FooterHint"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Opacity="0.65"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
