<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orbit_App.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Orbit_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnOpenCommandPalette" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnQuickCapture" />
        <KeyboardAccelerator Key="O" Modifiers="Control,Shift" Invoked="OnPushOutlook" />
    </Page.KeyboardAccelerators>

    <Grid
        AllowDrop="True"
        Background="Transparent"
        DragOver="Shell_DragOver"
        Drop="Shell_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="DutyInfoBar"
            Title="Orbit"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational" />

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AutomationProperties.Name="Orbit navigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel
                    Orientation="Horizontal"
                    Padding="10,10,8,6"
                    Spacing="8">
                    <controls:OrbitMark MarkSize="28" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Orbit" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    AutomationProperties.Name="Pulse"
                    Content="Pulse"
                    Tag="nav.pulse">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.Name="Ignition"
                    Content="Ignition"
                    Tag="nav.ignition">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.Name="Files"
                    Content="Files"
                    Tag="nav.files">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.Name="Search"
                    Content="Search"
                    Tag="nav.search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.Name="People"
                    Content="People"
                    Tag="nav.people">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    AutomationProperties.Name="Hermes"
                    Content="Hermes"
                    Tag="nav.agent">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE99A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.Name="Board"
                    Content="Board"
                    Tag="nav.workbench"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.Name="Settings"
                    Content="Settings"
                    Tag="nav.settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.Name="About"
                    Content="About"
                    Tag="nav.about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="12,8,12,4">
                    <Button
                        x:Name="CommandBarSearch"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Open command palette"
                        Click="CommandBarSearch_Click"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image
                                Width="18"
                                Height="18"
                                Source="ms-appx:///Assets/Brand/orbit-tray-24.png"
                                Stretch="Uniform" />
                            <FontIcon FontSize="14" Glyph="&#xE721;" />
                            <TextBlock Text="Search or run a command" />
                            <TextBlock
                                Margin="8,0,0,0"
                                Opacity="0.7"
                                Text="Ctrl+K" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="1"
                    AutomationProperties.Name="Main content" />
            </Grid>
        </NavigationView>

        <controls:CommandPalette
            x:Name="CommandPaletteHost"
            CommandInvoked="CommandPaletteHost_CommandInvoked" />
    </Grid>
</Page>
