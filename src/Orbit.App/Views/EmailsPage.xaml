<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orbit_App.Views.EmailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    mc:Ignorable="d">

    <Grid Padding="16,8,16,12" RowSpacing="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Emails" />

        <Border
            x:Name="DropZone"
            Grid.Row="1"
            MinHeight="120"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Drop a .msg file here" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.75"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="If Outlook drag fails, Save As .msg then drop"
                    TextWrapping="WrapWholeWords" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Browse for MSG"
                        Click="Browse_Click"
                        Content="Browse…" />
                    <Button
                        x:Name="PushFromOutlookButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Push selected Outlook mail"
                        Click="PushFromOutlook_Click"
                        Content="Push selected from Outlook"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        x:Name="OpenInOutlookButton"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Open last email in Outlook"
                        Click="OpenInOutlook_Click"
                        Content="Open in Outlook"
                        IsEnabled="False" />
                </StackPanel>
                <TextBlock
                    Opacity="0.75"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Or press Ctrl+Shift+O from the Workbench. Hermes organizes in place — no Agent chat hop. Approvals only appear for real ambiguous merges."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Link to projects (optional)" />
            <ListView
                x:Name="ProjectList"
                MaxHeight="120"
                AutomationProperties.Name="Projects to link"
                SelectionMode="Multiple">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <Border
            Grid.Row="3"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
            <ScrollViewer>
                <TextBlock
                    x:Name="SummaryText"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="Parsed summary appears here after ingest."
                    TextWrapping="WrapWholeWords" />
            </ScrollViewer>
        </Border>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Opacity="0.7"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Classic Outlook OLE drop is best-effort. If Outlook drag fails, Save As .msg then drop or browse." />
    </Grid>
</Page>
