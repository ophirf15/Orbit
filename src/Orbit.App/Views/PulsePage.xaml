<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orbit_App.Views.PulsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource OrbitWorkbenchSurfaceBrush}">
        <Grid x:Name="PulseHome" Padding="20,12,20,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="Orbit" />
                    <TextBlock
                        x:Name="GeneratedAtText"
                        Opacity="0.65"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Hermes feeds this home — open a concern to act." />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="IgnitionButton"
                        AutomationProperties.Name="Open ignition"
                        Click="IgnitionButton_Click"
                        Content="Add projects"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="RefreshButton"
                        AutomationProperties.Name="Refresh pulse"
                        Click="RefreshButton_Click"
                        Content="Refresh">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Always-on visual of every project in the orbit -->
            <StackPanel Grid.Row="1" Spacing="8">
                <Grid>
                    <TextBlock
                        FontWeight="SemiBold"
                        Opacity="0.85"
                        Text="Projects" />
                    <HyperlinkButton
                        x:Name="ClearFilterLink"
                        HorizontalAlignment="Right"
                        Click="ClearFilter_Click"
                        Content="Show all"
                        Visibility="Collapsed" />
                </Grid>
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <ItemsRepeater x:Name="ProjectsRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    MinWidth="140"
                                    MaxWidth="200"
                                    Padding="14,12"
                                    Click="ProjectTile_Click"
                                    HorizontalContentAlignment="Left"
                                    Tag="{Binding Id}">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            MaxLines="2"
                                            Opacity="0.65"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding SummaryLine}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
                <TextBlock
                    x:Name="ProjectsEmptyText"
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="No projects in orbit yet — ask Hermes to open one, or use Add projects."
                    Visibility="Collapsed" />
            </StackPanel>

            <Border
                Grid.Row="2"
                Padding="14,12"
                Background="{ThemeResource OrbitDetailSurfaceBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <StackPanel Spacing="6">
                    <TextBlock
                        FontWeight="SemiBold"
                        Opacity="0.8"
                        Text="From Hermes" />
                    <TextBlock
                        x:Name="DayBriefText"
                        LineHeight="22"
                        Text="Loading…"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="HermesHintText"
                        Opacity="0.55"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="3"
                Padding="14,12"
                Background="{ThemeResource OrbitDetailSurfaceBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontWeight="SemiBold"
                        Opacity="0.8"
                        Text="Briefing" />
                    <TextBlock x:Name="BriefingMeetingsHeader" FontWeight="SemiBold" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="Calendar · next 7 days" Visibility="Collapsed" />
                    <ItemsControl x:Name="BriefingMeetingsList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Opacity="0.85" Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="BriefingActionsHeader" FontWeight="SemiBold" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="Top actions" Visibility="Collapsed" />
                    <ItemsControl x:Name="BriefingActionsList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Opacity="0.85" Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="BriefingWaitingHeader" FontWeight="SemiBold" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="Waiting on" Visibility="Collapsed" />
                    <ItemsControl x:Name="BriefingWaitingList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Opacity="0.85" Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="BriefingAlertsHeader" FontWeight="SemiBold" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="Alerts" Visibility="Collapsed" />
                    <ItemsControl x:Name="BriefingAlertsList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Opacity="0.85" Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="BriefingChangesHeader" FontWeight="SemiBold" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" Text="Changes since last check" Visibility="Collapsed" />
                    <ItemsControl x:Name="BriefingChangesList" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Opacity="0.85" Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        x:Name="BriefingEmptyText"
                        Opacity="0.65"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="No briefing signals yet — sync calendars and fill project dossiers." />
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="UnmatchedMailPanel" Spacing="6" Visibility="Collapsed">
                    <TextBlock
                        x:Name="UnmatchedMailHeader"
                        FontWeight="SemiBold"
                        Opacity="0.85"
                        Text="Unmatched mail" />
                    <ListView
                        x:Name="UnmatchedMailList"
                        MaxHeight="160"
                        AutomationProperties.Name="Unmatched mail"
                        IsItemClickEnabled="True"
                        ItemClick="UnmatchedMailList_ItemClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="12,10"
                                    Background="{ThemeResource OrbitFieldFillBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{Binding Summary}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            MaxLines="3"
                                            Opacity="0.75"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding CaptionLine}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <TextBlock
                    x:Name="ConcernsHeader"
                    Grid.Row="1"
                    FontWeight="SemiBold"
                    Opacity="0.85"
                    Text="Needs you now" />
                <ListView
                    x:Name="ConcernsList"
                    Grid.Row="2"
                    AutomationProperties.Name="Concerns"
                    IsItemClickEnabled="True"
                    ItemClick="ConcernsList_ItemClick"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,8"
                                Padding="14,12"
                                Background="{ThemeResource OrbitFieldFillBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="4"
                                        Margin="0,2,0,2"
                                        Background="{ThemeResource OrbitCellAccentBrush}"
                                        CornerRadius="2" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Opacity="0.75"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding SubtitleLine}" />
                                        <TextBlock
                                            Opacity="0.6"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding SourceLine}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            MaxLines="2"
                                            Opacity="0.65"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding BodyExcerpt}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <TextBlock
                x:Name="StatusText"
                Grid.Row="5"
                Opacity="0.7"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="" />
        </Grid>

        <Frame x:Name="DetailFrame" Visibility="Collapsed" />
    </Grid>
</Page>
