<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orbit_App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="12" MaxWidth="720">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <Image
                    Width="72"
                    Height="72"
                    Source="ms-appx:///Assets/Brand/orbit-128.png"
                    Stretch="Uniform" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Orbit" />
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="About / Diagnostics" Opacity="0.85" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="VersionText" TextWrapping="Wrap" />
            <TextBlock x:Name="TfmText" TextWrapping="Wrap" />
            <TextBlock x:Name="SettingsPathText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="DataPathText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock x:Name="HostStatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Updates" Margin="0,12,0,0" />
            <TextBlock
                Opacity="0.85"
                TextWrapping="Wrap"
                Text="Primary lane: MSIX + App Installer (GitHub Releases). Daily builds stay unpackaged." />
            <TextBlock
                x:Name="UpdateStatusText"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="ReleaseNotesText"
                IsTextSelectionEnabled="True"
                Opacity="0.9"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <HyperlinkButton
                x:Name="ReleaseNotesLink"
                Content="Open release notes"
                Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="CheckUpdatesButton"
                    AutomationProperties.Name="Check for updates"
                    Click="CheckUpdatesButton_Click"
                    Content="Check now" />
                <Button
                    x:Name="InstallUpdateButton"
                    AutomationProperties.Name="Install update"
                    Click="InstallUpdateButton_Click"
                    Content="Install update"
                    IsEnabled="False" />
            </StackPanel>
            <TextBlock
                x:Name="UpdateActionText"
                IsTextSelectionEnabled="True"
                Opacity="0.85"
                TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Diagnostics" Margin="0,12,0,0" />
            <TextBlock
                Opacity="0.85"
                TextWrapping="Wrap"
                Text="Export a redacted bundle (schema, sync, index counts, Hermes last-known, calendar providers, capabilities). API keys and email bodies are excluded." />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="ExportDiagnosticsButton"
                    AutomationProperties.Name="Export diagnostics"
                    Click="ExportDiagnosticsButton_Click"
                    Content="Export support bundle" />
            </StackPanel>
            <TextBlock
                x:Name="DiagnosticsActionText"
                IsTextSelectionEnabled="True"
                Opacity="0.85"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
