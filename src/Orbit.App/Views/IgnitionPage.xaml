<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orbit_App.Views.IgnitionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,20">
        <StackPanel MaxWidth="720" Spacing="20">
            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="Ignition" />
                <TextBlock
                    LineHeight="22"
                    Opacity="0.85"
                    Text="Teach Orbit the projects that matter. Hermes expands each name, learns from your folders, and keeps them warm on Pulse."
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="Project names" />
                <TextBlock
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="One project name per line." />
                <TextBox
                    x:Name="NamesBox"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Project names"
                    Background="{ThemeResource OrbitFieldFillBrush}"
                    Height="120"
                    PlaceholderText="Alpha&#x0a;Beta&#x0a;Gamma"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="FromListButton"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Create from list"
                    Click="FromListButton_Click"
                    Content="Create from list" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="Projects folder" />
                <TextBlock
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Link every subfolder under a root as a project." />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="RootPathBox"
                        AutomationProperties.Name="Projects root path"
                        Background="{ThemeResource OrbitFieldFillBrush}"
                        PlaceholderText="C:\Projects" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Browse folder"
                        Click="BrowseFolder_Click"
                        Content="Browse" />
                </Grid>
                <Button
                    x:Name="LinkFolderButton"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Link projects folder"
                    Click="LinkFolderButton_Click"
                    Content="Link Projects folder" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="Results" />
                <ListView
                    x:Name="ResultsList"
                    AutomationProperties.Name="Ignition results"
                    MaxHeight="240"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Padding="4,6"
                                Text="{Binding DisplayLine}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="ConfirmButton"
                    AutomationProperties.Name="Confirm orbit"
                    Click="ConfirmButton_Click"
                    Content="Confirm orbit"
                    Style="{StaticResource AccentButtonStyle}" />
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Add projects, then confirm to start Pulse." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
