<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orbit_App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="0" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Padding="24,20,24,8"
            Orientation="Horizontal"
            Spacing="10">
            <Image
                Width="32"
                Height="32"
                Source="ms-appx:///Assets/Brand/orbit-48.png"
                Stretch="Uniform"
                VerticalAlignment="Center" />
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Settings"
                VerticalAlignment="Center" />
        </StackPanel>

        <NavigationView
            x:Name="SettingsNav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            OpenPaneLength="200"
            PaneDisplayMode="Left"
            SelectionChanged="SettingsNav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Appearance"
                    IsSelected="True"
                    Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Hermes" Tag="hermes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE99A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Mail &amp; calendar" Tag="mail">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE715;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Backup &amp; sync" Tag="backup">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Updates" Tag="updates">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE895;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Advanced" Tag="advanced">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer Padding="24,8,24,16">
                <Grid MaxWidth="640" HorizontalAlignment="Left">
                    <!-- Appearance -->
                    <StackPanel x:Name="PaneAppearance" Spacing="16">
                        <ComboBox
                            x:Name="ThemeCombo"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Theme preference"
                            Header="Theme" />
                    </StackPanel>

                    <!-- Hermes -->
                    <StackPanel x:Name="PaneHermes" Spacing="16" Visibility="Collapsed">
                        <TextBlock
                            Opacity="0.85"
                            TextWrapping="Wrap"
                            Text="Connect Hermes on this PC or point at a remote API." />

                        <ComboBox
                            x:Name="HermesModeCombo"
                            HorizontalAlignment="Stretch"
                            Header="Connection mode"
                            SelectionChanged="HermesModeCombo_SelectionChanged">
                            <ComboBoxItem Content="This PC (one-click)" Tag="ThisPc" />
                            <ComboBoxItem Content="Manual / remote" Tag="Manual" />
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Ellipse
                                x:Name="HermesStatusDot"
                                Width="12"
                                Height="12"
                                Fill="{ThemeResource SystemFillColorCautionBrush}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="HermesStatusText"
                                Text="Checking…"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock
                            x:Name="HermesInstallText"
                            Opacity="0.75"
                            TextWrapping="Wrap"
                            Text="" />

                        <StackPanel x:Name="HermesThisPcPanel" Spacing="8">
                            <Button
                                x:Name="ConnectHermesThisPcButton"
                                Click="ConnectHermesThisPcButton_Click"
                                Content="Connect Hermes"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                MinWidth="160" />
                            <Button
                                Click="OpenHermesDashboardInApp_Click"
                                Content="Open dashboard"
                                HorizontalAlignment="Left" />
                            <Button
                                Click="ClearStuckOperatorRuns_Click"
                                Content="Clear stuck runs"
                                HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel x:Name="HermesManualPanel" Spacing="8" Visibility="Collapsed">
                            <TextBox
                                x:Name="HermesUrlBox"
                                AutomationProperties.Name="Hermes base URL"
                                Header="API base URL"
                                PlaceholderText="http://127.0.0.1:8642" />
                            <PasswordBox
                                x:Name="HermesApiKeyBox"
                                AutomationProperties.Name="Hermes API key"
                                Header="API key (leave blank to keep existing)"
                                PasswordRevealMode="Peek" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="ConnectHermesButton"
                                    Click="ConnectHermesButton_Click"
                                    Content="Connect &amp; save"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Name="TestHermesButton"
                                    Click="TestHermesButton_Click"
                                    Content="Test" />
                                <Button
                                    Click="OpenHermesDashboardInApp_Click"
                                    Content="Dashboard" />
                                <Button
                                    Click="ClearStuckOperatorRuns_Click"
                                    Content="Clear stuck runs" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            x:Name="HermesTestResultText"
                            IsTextSelectionEnabled="True"
                            Opacity="0.9"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Mail & calendar -->
                    <StackPanel x:Name="PaneMail" Spacing="16" Visibility="Collapsed">
                        <TextBlock
                            Opacity="0.85"
                            TextWrapping="Wrap"
                            Text="Classic Outlook push, optional Graph sign-in, and ICS calendars." />

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Classic Outlook add-in" />
                        <TextBlock
                            Opacity="0.85"
                            TextWrapping="Wrap"
                            Text="Ribbon “Send to Orbit” (close Outlook if install is locked)." />
                        <TextBlock
                            x:Name="OutlookAddInStatusText"
                            Opacity="0.9"
                            TextWrapping="Wrap"
                            Text="Checking…" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="InstallOutlookAddInButton"
                                Click="InstallOutlookAddInButton_Click"
                                Content="Install / Update"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="UninstallOutlookAddInButton"
                                Click="UninstallOutlookAddInButton_Click"
                                Content="Uninstall" />
                        </StackPanel>
                        <TextBlock
                            x:Name="OutlookAddInActionText"
                            Opacity="0.85"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Microsoft Graph" />
                        <TextBox
                            x:Name="GraphClientIdBox"
                            Header="Client ID (optional)"
                            PlaceholderText="Entra public-client app ID" />
                        <TextBox
                            x:Name="GraphTenantBox"
                            Header="Tenant"
                            PlaceholderText="common" />
                        <TextBlock x:Name="GraphAccountText" Opacity="0.85" Text="Not signed in." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="GraphSignInButton" Click="GraphSignInButton_Click" Content="Sign in with Microsoft" />
                            <Button x:Name="GraphSignOutButton" Click="GraphSignOutButton_Click" Content="Sign out" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="GraphStatusText" Opacity="0.85" TextWrapping="Wrap" Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Calendar" />
                        <TextBox
                            x:Name="CalendarIcsBox"
                            Header="ICS path or URL (optional)"
                            PlaceholderText="C:\path\to\calendar.ics" />
                        <Button x:Name="CalendarSyncButton" Click="CalendarSyncButton_Click" Content="Sync calendars" HorizontalAlignment="Left" />
                        <TextBlock x:Name="CalendarSourcesText" TextWrapping="Wrap" />
                        <StackPanel x:Name="CalendarSourcesPanel" Spacing="8" />
                        <TextBlock x:Name="CalendarStatusText" Opacity="0.85" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Backup & sync -->
                    <StackPanel x:Name="PaneBackup" Spacing="16" Visibility="Collapsed">
                        <TextBlock
                            Opacity="0.85"
                            TextWrapping="Wrap"
                            Text="Live DB stays on this PC; versioned snapshots go to a synced folder." />
                        <TextBlock x:Name="OneDrivePathText" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ChooseBackupFolderButton" Click="ChooseBackupFolderButton_Click" Content="Choose folder…" />
                            <Button x:Name="ClearBackupFolderButton" Click="ClearBackupFolderButton_Click" Content="Clear" />
                        </StackPanel>
                        <TextBlock x:Name="SyncDeviceText" Opacity="0.85" TextWrapping="Wrap" />
                        <TextBlock x:Name="SyncConflictText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="SyncStatusText" Opacity="0.85" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SnapshotNowButton" Click="SnapshotNowButton_Click" Content="Backup now" />
                            <Button x:Name="RefreshSnapshotsButton" Click="RefreshSnapshotsButton_Click" Content="Refresh list" />
                            <Button x:Name="RestoreSnapshotButton" Click="RestoreSnapshotButton_Click" Content="Restore selected" />
                        </StackPanel>
                        <ListView x:Name="SnapshotsList" MaxHeight="180" SelectionMode="Single" />
                    </StackPanel>

                    <!-- Updates -->
                    <StackPanel x:Name="PaneUpdates" Spacing="16" Visibility="Collapsed">
                        <TextBlock x:Name="UpdatesStatusText" Opacity="0.85" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdatesButton" Click="CheckUpdatesButton_Click" Content="Check now" />
                            <Button x:Name="InstallUpdateButton" Click="InstallUpdateButton_Click" Content="Install update" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="UpdatesActionText" Opacity="0.85" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Advanced -->
                    <StackPanel x:Name="PaneAdvanced" Spacing="16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Hermes install variants" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="OpenHermesDashboardButton"
                                Click="OpenHermesDashboardButton_Click"
                                Content="Open dashboard in browser" />
                            <Button
                                x:Name="PrepareLocalHermesButton"
                                Click="PrepareLocalHermesButton_Click"
                                Content="Prepare Docker folder" />
                            <Button
                                x:Name="CopyCoreEnvForHermesButton"
                                Click="CopyCoreEnvForHermesButton_Click"
                                Content="Copy Core env" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Diagnostics" />
                        <Button
                            x:Name="ExportDiagnosticsButton"
                            Click="ExportDiagnosticsButton_Click"
                            Content="Export support bundle"
                            HorizontalAlignment="Left" />
                        <TextBlock x:Name="DiagnosticsActionText" Opacity="0.85" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Developer" />
                        <ToggleSwitch
                            x:Name="DeveloperToggle"
                            Header="Developer mode"
                            OffContent="Off"
                            OnContent="On"
                            Toggled="DeveloperToggle_Toggled" />
                        <TextBox
                            x:Name="SourceRepoRootBox"
                            Header="Source repository root"
                            Visibility="Collapsed" />

                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Core Host" />
                        <ToggleSwitch
                            x:Name="HostToggle"
                            Header="Background host enabled"
                            OffContent="Off"
                            OnContent="On" />
                        <TextBox x:Name="CoreHostUrlBox" Header="Core Host base URL" />
                        <TextBox x:Name="CoreHostBindBox" Header="Core Host bind address" />
                        <PasswordBox
                            x:Name="CoreHostApiKeyBox"
                            Header="Core Host API key"
                            PasswordRevealMode="Peek" />
                        <TextBlock x:Name="HostConnectionText" TextWrapping="Wrap" />
                        <TextBlock x:Name="PathsText" TextWrapping="Wrap" />
                        <TextBlock x:Name="KeyRefText" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>

        <Border
            Grid.Row="2"
            Padding="24,12"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button
                    x:Name="SaveButton"
                    Click="SaveButton_Click"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}" />
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
