<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orbit_App.Views.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Orbit_App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Orbit_App.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource OrbitWorkbenchSurfaceBrush}">
        <Grid
            x:Name="WorkbenchRoot"
            AllowDrop="True"
            Background="Transparent"
            DragOver="WorkbenchRoot_DragOver"
            Drop="WorkbenchRoot_Drop"
            Padding="16,8,16,12"
            RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <controls:OrbitMark MarkSize="28" />
                        <TextBlock
                            x:Name="WorkbenchTitle"
                            VerticalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Orbit" />
                        <TextBlock x:Name="WorkbenchSubtitle" Visibility="Collapsed" />
                        <TextBlock
                            x:Name="WorkbenchHint"
                            MaxWidth="360"
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            x:Name="AddTaskButton"
                            Click="AddTask_Click"
                            Content="Add task"
                            IsEnabled="True" />
                        <Button
                            x:Name="AddSubtaskButton"
                            Click="AddSubtask_Click"
                            Content="Add subtask"
                            IsEnabled="False" />
                        <Button
                            x:Name="PushOutlookButton"
                            AutomationProperties.Name="Push selected Outlook mail"
                            Click="PushOutlook_Click"
                            Content="Push Outlook mail"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Ctrl+Shift+O — select mail in Outlook first" />
                    </StackPanel>
                </Grid>
                <!-- Combined status; AgentStatusText / UpcomingMeetingsText kept for code-behind setters -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="0">
                    <TextBlock
                        x:Name="AgentStatusText"
                        AutomationProperties.Name="Agent status"
                        Opacity="0.55"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        MaxWidth="280" />
                    <TextBlock
                        x:Name="StatusSep"
                        Opacity="0.4"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="  ·  "
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="UpcomingMeetingsText"
                        AutomationProperties.Name="Upcoming meetings"
                        Opacity="0.55"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextTrimming="CharacterEllipsis"
                        MaxWidth="420" />
                </StackPanel>
            </Grid>

            <controls:HermesHomeStrip
                x:Name="HermesStrip"
                Grid.Row="1"
                ConcernClicked="HermesStrip_ConcernClicked"
                DismissLowConfidenceRequested="HermesStrip_DismissLowConfidenceRequested"
                OpenReviewRequested="HermesStrip_OpenReviewRequested"
                RefreshRequested="HermesStrip_RefreshRequested" />

            <Grid x:Name="WorkbenchBody" Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.38*" MinWidth="260" />
                    <ColumnDefinition Width="0.62*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="10"
                    Background="{ThemeResource OrbitDetailSurfaceBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        <TextBlock
                            FontWeight="SemiBold"
                            Opacity="0.85"
                            Text="Work" />
                        <TreeView
                            x:Name="OrbitTree"
                            Grid.Row="1"
                            AllowDrop="True"
                            AutomationProperties.Name="Orbit work tree"
                            CanDragItems="True"
                            CanReorderItems="False"
                            ContextRequested="OrbitTree_ContextRequested"
                            DragItemsCompleted="OrbitTree_DragItemsCompleted"
                            DragItemsStarting="OrbitTree_DragItemsStarting"
                            DragOver="OrbitTree_DragOver"
                            Drop="OrbitTree_Drop"
                            ItemInvoked="OrbitTree_ItemInvoked"
                            SelectionChanged="OrbitTree_SelectionChanged"
                            SelectionMode="Single">
                            <TreeView.ItemTemplate>
                                <DataTemplate x:DataType="vm:OrbitTreeNodeVm">
                                    <TreeViewItem
                                        AllowDrop="True"
                                        CanDrag="True"
                                        IsExpanded="True"
                                        ItemsSource="{x:Bind Children}"
                                        CollapsedGlyph="&#xE76C;"
                                        ExpandedGlyph="&#xE70D;"
                                        ContextRequested="OrbitTreeItem_ContextRequested"
                                        DragOver="OrbitTreeItem_DragOver"
                                        Drop="OrbitTreeItem_Drop">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneWay}">
                                            <FontIcon FontSize="12" Glyph="{x:Bind Glyph, Mode=OneWay}" Opacity="0.75" />
                                            <StackPanel Spacing="1">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Opacity="0.65"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Subtitle, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </TreeViewItem>
                                </DataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <Expander
                            x:Name="ReviewQueueExpander"
                            Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="False"
                            Visibility="Collapsed">
                            <Expander.Header>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="ReviewQueueHeaderText"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="Review queue" />
                                    <Button
                                        x:Name="ReviewDismissAllButton"
                                        Grid.Column="1"
                                        Click="ReviewDismissAllButton_Click"
                                        Content="Dismiss all"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        ToolTipService.ToolTip="Reject all low-confidence suggestions (teaches Hermes what not to propose)" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="6" Padding="0,6,0,0">
                                <TextBlock
                                    Opacity="0.65"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Accept, reject, or always — each decision trains Hermes."
                                    TextWrapping="Wrap" />
                                <ListView
                                    x:Name="ReviewQueueList"
                                    MaxHeight="220"
                                    AutomationProperties.Name="Suggestion review queue"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PendingSuggestionVm">
                                            <Grid Margin="0,0,0,8" ColumnSpacing="8" RowSpacing="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Summary}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Opacity="0.65"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind MetaLine}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel
                                                    Grid.Row="2"
                                                    Grid.ColumnSpan="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="0,4,0,0">
                                                    <Button
                                                        Click="ReviewAcceptButton_Click"
                                                        Content="Accept"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Tag="{x:Bind Id}"
                                                        ToolTipService.ToolTip="Apply this suggestion and teach Hermes it was right" />
                                                    <Button
                                                        Click="ReviewRejectButton_Click"
                                                        Content="Reject"
                                                        Tag="{x:Bind Id}"
                                                        ToolTipService.ToolTip="Reject and teach Hermes not to propose this again" />
                                                    <Button
                                                        Click="ReviewAlwaysButton_Click"
                                                        Content="Always"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Tag="{x:Bind Id}"
                                                        ToolTipService.ToolTip="Accept and create a standing rule for similar cases" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Expander>
                        <TextBox
                            x:Name="AgentInputBox"
                            Grid.Row="3"
                            AcceptsReturn="False"
                            AutomationProperties.Name="Ask, capture, or command Orbit"
                            CornerRadius="10"
                            KeyDown="AgentInputBox_KeyDown"
                            PlaceholderText="Ask, capture, or command Orbit…"
                            MinHeight="40" />
                        <TextBlock
                            x:Name="AgentQuickReply"
                            Grid.Row="4"
                            MaxHeight="96"
                            FontSize="12"
                            Opacity="0.85"
                            TextWrapping="Wrap"
                            TextTrimming="CharacterEllipsis"
                            IsTextSelectionEnabled="True"
                            Visibility="Collapsed" />
                        <!-- Hidden legacy hooks kept for code that still references them -->
                        <ComboBox x:Name="CellSizeCombo" Visibility="Collapsed" SelectionChanged="CellSizeCombo_SelectionChanged">
                            <ComboBoxItem Content="Compact" Tag="0" />
                            <ComboBoxItem Content="Comfortable" Tag="1" />
                            <ComboBoxItem Content="Large" Tag="2" />
                        </ComboBox>
                        <ScrollViewer x:Name="CellScroller" Visibility="Collapsed" SizeChanged="CellScroller_SizeChanged">
                            <Canvas x:Name="CellBoard" />
                        </ScrollViewer>
                        <ListView x:Name="AgentMessageList" Visibility="Collapsed" />
                        <Button x:Name="AgentSendButton" Visibility="Collapsed" Click="AgentSendButton_Click" />
                        <TextBlock x:Name="AgentRailStatus" Visibility="Collapsed" />
                        <TextBlock x:Name="AgentRailHint" Visibility="Collapsed" />
                        <Border x:Name="AgentRail" Visibility="Collapsed" />
                        <Border x:Name="DrawerHost" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="DrawerTitle" />
                                <StackPanel x:Name="DrawerBody" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="BackToRootButton" Visibility="Collapsed" Click="BackToRoot_Click" />
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource OrbitDetailSurfaceBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                    <Grid>
                        <TextBlock
                            x:Name="DetailEmptyText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.6"
                            Text="Select a project or task"
                            Style="{StaticResource BodyTextBlockStyle}" />
                        <ContentPresenter x:Name="DetailHost" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Frame x:Name="DetailFrame" Visibility="Collapsed" />
    </Grid>
</Page>
