<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Orbit_App.Views.ConcernBriefPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                AutomationProperties.Name="Back to pulse"
                Click="BackButton_Click"
                Content="← Pulse" />
            <Button
                x:Name="OpenEmailButton"
                AutomationProperties.Name="Open original email"
                Click="OpenEmailButton_Click"
                Content="Open email"
                Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBox
                x:Name="TitleBox"
                AutomationProperties.Name="Title"
                Background="{ThemeResource OrbitFieldFillBrush}"
                FontSize="20"
                FontWeight="SemiBold"
                LostFocus="Field_LostFocus"
                PlaceholderText="Title" />
            <TextBlock
                x:Name="ProjectText"
                Opacity="0.75"
                Style="{StaticResource CaptionTextBlockStyle}" />
            <ComboBox
                x:Name="StatusCombo"
                AutomationProperties.Name="Status"
                HorizontalAlignment="Left"
                MinWidth="160"
                SelectionChanged="StatusCombo_SelectionChanged">
                <ComboBoxItem Content="Active" Tag="active" />
                <ComboBoxItem Content="Blocked" Tag="blocked" />
                <ComboBoxItem Content="Waiting" Tag="waiting" />
                <ComboBoxItem Content="New" Tag="not_started" />
            </ComboBox>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="12">
                <StackPanel Spacing="6">
                    <TextBlock
                        FontWeight="SemiBold"
                        Opacity="0.8"
                        Text="Next action" />
                    <TextBox
                        x:Name="NextActionBox"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Next action"
                        Background="{ThemeResource OrbitFieldFillBrush}"
                        LostFocus="Field_LostFocus"
                        MinHeight="48"
                        PlaceholderText="What happens next?"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock
                        FontWeight="SemiBold"
                        Opacity="0.8"
                        Text="Living brief" />
                    <TextBox
                        x:Name="BodyBox"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Body"
                        Background="{ThemeResource OrbitFieldFillBrush}"
                        LostFocus="Field_LostFocus"
                        MinHeight="200"
                        PlaceholderText="Context, notes, and narrative…"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="3"
            Opacity="0.7"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Edits save when you leave a field." />
    </Grid>
</Page>
