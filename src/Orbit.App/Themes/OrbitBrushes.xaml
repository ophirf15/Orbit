<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Surfaces stay soft/neutral so system Mica shows through.
      Accent blues are for interactive affordances only (stripes, borders, CTAs).
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="OrbitWorkbenchSurfaceBrush" Color="#00000000" />
            <SolidColorBrush x:Key="OrbitCellAccentBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="OrbitLimboAccentBrush" Color="#C19C00" />
            <SolidColorBrush x:Key="OrbitCaptureSavedBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="OrbitNavSelectedBrush" Color="#14000000" />
            <SolidColorBrush x:Key="OrbitDetailHeaderBrush" Color="#B3F3F3F3" />
            <SolidColorBrush x:Key="OrbitDetailSurfaceBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="OrbitDetailFooterBrush" Color="#B3F0F0F0" />
            <SolidColorBrush x:Key="OrbitCellHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="OrbitFieldFillBrush" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="OrbitWorkbenchSurfaceBrush" Color="#00000000" />
            <SolidColorBrush x:Key="OrbitCellAccentBrush" Color="#4CC2FF" />
            <SolidColorBrush x:Key="OrbitLimboAccentBrush" Color="#F2C94C" />
            <SolidColorBrush x:Key="OrbitCaptureSavedBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="OrbitNavSelectedBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="OrbitDetailHeaderBrush" Color="#992A2A2A" />
            <SolidColorBrush x:Key="OrbitDetailSurfaceBrush" Color="#CC1F1F1F" />
            <SolidColorBrush x:Key="OrbitDetailFooterBrush" Color="#99181818" />
            <SolidColorBrush x:Key="OrbitCellHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="OrbitFieldFillBrush" Color="#E6222833" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="OrbitWorkbenchSurfaceBrush" Color="#00000000" />
            <SolidColorBrush x:Key="OrbitCellAccentBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="OrbitLimboAccentBrush" Color="#C19C00" />
            <SolidColorBrush x:Key="OrbitCaptureSavedBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="OrbitNavSelectedBrush" Color="#14000000" />
            <SolidColorBrush x:Key="OrbitDetailHeaderBrush" Color="#B3F3F3F3" />
            <SolidColorBrush x:Key="OrbitDetailSurfaceBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="OrbitDetailFooterBrush" Color="#B3F0F0F0" />
            <SolidColorBrush x:Key="OrbitCellHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="OrbitFieldFillBrush" Color="#FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
