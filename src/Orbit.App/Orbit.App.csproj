<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Orbit_App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged debug loop (KTD1). Packaging/update path is Phase 17. -->
    <WindowsPackageType>None</WindowsPackageType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.1</Version>
    <InformationalVersion>0.1.1</InformationalVersion>
    <!-- Embeds into Orbit.App.exe so Start/taskbar/shortcuts get the Orbit glyph. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orbit.Core\Orbit.Core.csproj" />
    <ProjectReference Include="..\Orbit.Infrastructure\Orbit.Infrastructure.csproj" />
    <ProjectReference Include="..\Orbit.Agent.Contracts\Orbit.Agent.Contracts.csproj" />
  </ItemGroup>

  <!--
    WinUI copies Content into bin\ on build, but `dotnet publish -o` drops items
    that lack CopyToPublishDirectory. Brand PNGs (ms-appx:///Assets/Brand/...)
    must ship with the Inno installer layout.
  -->
  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!--
      Hermes Connect/provision reads docs/hermes next to Orbit.App.exe
      (skills, cron/webhook manifests, portable scripts). Without this, a
      wizard install only gets the embedded chase-waiting fallback and cron
      skips pulse-refresh / duty-scan.
    -->
    <Content Include="..\..\docs\hermes\**\*">
      <Link>docs\hermes\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>

  <!--
    Stage thin Outlook launcher next to the app so Settings → Install works in
    local F5 builds (pack-installer.ps1 also publishes this folder for Setup).
    Use a separate `dotnet build` process so Orbit.App's -r win-x64 does not
    leak into the net48 project (NETSDK1047). Skip during pack publish —
    pack-installer.ps1 stages outlook-launcher itself.
  -->
  <Target Name="StageOutlookLauncher" AfterTargets="Build" Condition="'$(EnableStageOutlookLauncher)' != 'false'">
    <PropertyGroup>
      <_OutlookLauncherProj>$(MSBuildThisFileDirectory)..\Orbit.OutlookLauncher\Orbit.OutlookLauncher.csproj</_OutlookLauncherProj>
      <_OutlookLauncherOut Condition="Exists('$(MSBuildThisFileDirectory)..\Orbit.OutlookLauncher\bin\$(Platform)\$(Configuration)\net48\Orbit.OutlookLauncher.dll')">$(MSBuildThisFileDirectory)..\Orbit.OutlookLauncher\bin\$(Platform)\$(Configuration)\net48</_OutlookLauncherOut>
      <_OutlookLauncherOut Condition="'$(_OutlookLauncherOut)' == ''">$(MSBuildThisFileDirectory)..\Orbit.OutlookLauncher\bin\$(Configuration)\net48</_OutlookLauncherOut>
      <_DotNetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</_DotNetHost>
      <_DotNetHost Condition="'$(_DotNetHost)' == ''">dotnet</_DotNetHost>
    </PropertyGroup>
    <Exec
      Command="&quot;$(_DotNetHost)&quot; build &quot;$(_OutlookLauncherProj)&quot; -c $(Configuration) -p:Platform=$(Platform) --nologo -v:minimal"
      Condition="Exists('$(_OutlookLauncherProj)')" />
    <PropertyGroup>
      <_OutlookLauncherOut Condition="Exists('$(MSBuildThisFileDirectory)..\Orbit.OutlookLauncher\bin\$(Platform)\$(Configuration)\net48\Orbit.OutlookLauncher.dll')">$(MSBuildThisFileDirectory)..\Orbit.OutlookLauncher\bin\$(Platform)\$(Configuration)\net48</_OutlookLauncherOut>
      <_OutlookLauncherOut Condition="!Exists('$(_OutlookLauncherOut)\Orbit.OutlookLauncher.dll')">$(MSBuildThisFileDirectory)..\Orbit.OutlookLauncher\bin\$(Configuration)\net48</_OutlookLauncherOut>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_OutlookLauncherOut)\Orbit.OutlookLauncher.dll')">
      <_OutlookLauncherFiles Include="$(_OutlookLauncherOut)\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)outlook-launcher" Condition="'@(_OutlookLauncherFiles)' != ''" />
    <Copy
      SourceFiles="@(_OutlookLauncherFiles)"
      DestinationFolder="$(OutDir)outlook-launcher\%(RecursiveDir)"
      SkipUnchangedFiles="true"
      Condition="'@(_OutlookLauncherFiles)' != ''" />
  </Target>
</Project>