# Hermes API key (Orbit Settings → Hermes API key must match)
# Generate a strong random string; put the same value in docker-compose / Hermes config.
API_SERVER_KEY=

# Orbit Core Host — reachable FROM the Hermes machine
# Loopback only works if Core is on the same host or tunneled:
#   ORBIT_CORE_URL=http://127.0.0.1:8741
# LAN example (Core on another machine):
#   ORBIT_CORE_URL=http://192.168.x.y:8741
ORBIT_CORE_URL=http://127.0.0.1:8741

# Orbit Core Bearer API key (from Orbit Settings / Core Host key sidecar). Never commit the real value.
ORBIT_API_KEY=

# Optional: Telegram stays Hermes-only (BotFather token in Hermes gateway config, not Orbit).
# TELEGRAM_BOT_TOKEN=
